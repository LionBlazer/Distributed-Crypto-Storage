[
  {
    "label": "FHE: Open GUI playground",
    "command": "$env:CARGO_ENCODED_RUSTFLAGS = $null; & (rustup which cargo) run --release --locked -p dcs-launch -- playground; exit $LASTEXITCODE",
    "shell": {
      "with_arguments": {
        "program": "powershell.exe",
        "args": ["-NoProfile"]
      }
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "CARGO_HOME": "$ZED_WORKTREE_ROOT/.local/cargo-home",
      "CARGO_TARGET_DIR": "$ZED_WORKTREE_ROOT/.local/target-launcher",
      "RUSTFLAGS": "-C opt-level=3"
    },
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "no_focus",
    "save": "all"
  }
]
